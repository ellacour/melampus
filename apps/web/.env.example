# Mélampus — web app env
# Copy to .env.local for local dev. Never commit .env.local.

# Backend API (Django REST). Production: https://api.melampus.fr
VITE_API_URL=http://localhost:8000/api

# Mot de passe partagé d'équipe pour /design-system.
# Cette route sert l'identité visuelle (puis Storybook) — pas du contenu
# secret, mais on ne veut pas qu'elle soit indexée ni exposée librement.
# Tourner ce mot de passe à chaque départ d'équipe.
VITE_DESIGN_SYSTEM_PASSWORD=melampus
